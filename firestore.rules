rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /foyers/{code} {
      allow get: if request.auth != null && code.size() >= 20;
      allow list, delete: if false;
      allow create, update: if request.auth != null
        && code.size() >= 20
        && request.resource.data.keys().hasOnly(['people','excl','seed','start','days','cheap','stock','done','ledger','v','checked','updatedAt'])
        && request.resource.data.size() <= 12;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
